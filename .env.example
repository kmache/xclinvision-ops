# XCLinVision-Ops — Environment Variables
# Copy this file to .env and fill in your values.

# ── OpenAI / LLM ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-nano
OPENAI_API_BASE=https://api.openai.com/v1
LLM_DEFAULT_PROVIDER=openai

# ── Local LLM (optional, for Ollama / vLLM) ──────────────────────────
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3

# ── API authentication (required for v2 PII endpoints) ──────────────
# Single shared bearer token. If unset, all protected v2 endpoints
# return 503 (fail-secure). Generate with `openssl rand -hex 32`.
XCLINVISION_API_TOKEN=

# ── Persistent storage ──────────────────────────────────────────────
# XCLINVISION_DB_PATH=data/xclinvision.db
# XCLINVISION_IMAGE_DIR=data/images
