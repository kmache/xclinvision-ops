# XCLinVision-Ops — Environment Variables
# Copy this file to .env and fill in your values.

# ── OpenAI / LLM ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1
LLM_DEFAULT_PROVIDER=openai

# ── Local LLM (optional, for Ollama / vLLM) ──────────────────────────
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3.2

# ── API authentication (REQUIRED for v2 PII endpoints) ──────────────
# REQUIRED. Single shared bearer token. If this is unset or empty, EVERY
# protected v2 endpoint returns 503 (fail-secure) and the API will look
# "down" to clients — this is the #1 cause of a working build serving 503s.
#
# Generate one with:
#     openssl rand -hex 32
#
# Left intentionally EMPTY below: a copied-but-unedited .env must fail closed
# rather than ship a token whose value is public in this repo.
XCLINVISION_API_TOKEN=

# ── Persistent storage ──────────────────────────────────────────────
# XCLINVISION_DB_PATH=data/xclinvision.db
# XCLINVISION_IMAGE_DIR=data/images
